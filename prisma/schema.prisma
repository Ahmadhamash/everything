generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  INSTAGRAM_CAPTION
  FACEBOOK_POST
  REEL_SCRIPT
  TIKTOK_SCRIPT
  PRODUCT_DESCRIPTION
  SHORT_AD_COPY
  LONG_AD_COPY
  WHATSAPP_MESSAGE
  HASHTAGS
  LANDING_COPY
  FAQ
  OFFER_IDEAS
}

enum Tone {
  FUNNY
  LUXURY
  EMOTIONAL
  DIRECT_SALES
  YOUTHFUL
  FORMAL
}

model User {
  id             String             @id @default(cuid())
  name           String?
  email          String             @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  stores         Store[]
  generated      GeneratedContent[]
  plans          SubscriptionPlan[]
  usageLogs      UsageLog[]
  accounts       Account[]
  sessions       Session[]
}

model Store {
  id               String      @id @default(cuid())
  userId           String
  name             String
  slug             String      @unique
  category         String
  description      String
  targetAudience   String
  toneOfVoice      String
  country          String
  socialLinks      Json?
  brandColors      Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products         Product[]
  landingPages     LandingPage[]
}

model Product {
  id               String             @id @default(cuid())
  storeId          String
  name             String
  slug             String             @unique
  price            Decimal            @db.Decimal(10, 2)
  description      String
  category         String
  features         String[]
  targetCustomer   String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  images           ProductImage[]
  generatedContent GeneratedContent[]
  landingPages     LandingPage[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model GeneratedContent {
  id          String      @id @default(cuid())
  userId      String
  productId   String
  type        ContentType
  tone        Tone
  prompt      String
  output      Json
  rawText     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model LandingPage {
  id             String   @id @default(cuid())
  storeId        String
  productId      String?
  slug           String   @unique
  title          String
  hero           String
  benefits       String[]
  cta            String
  faq            Json?
  whatsappNumber String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model SubscriptionPlan {
  id               String   @id @default(cuid())
  userId           String
  name             String
  monthlyLimit     Int      @default(10)
  active           Boolean  @default(true)
  currentMonth     String
  usedGenerations  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currentMonth])
}

model UsageLog {
  id         String      @id @default(cuid())
  userId     String
  storeId    String?
  productId  String?
  type       ContentType
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
