DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_store_builder"
AUTH_SECRET="replace-with-long-random-secret"
# Gemini options:
# 1) Free mock mode: GEMINI_API_KEY="" and AI_MOCK_MODE="true"
# 2) Real Gemini: set your key and switch AI_MOCK_MODE="false" in production
GEMINI_API_KEY="your-gemini-api-key"
AI_MOCK_MODE="true"
NEXTAUTH_URL="http://localhost:3000"
